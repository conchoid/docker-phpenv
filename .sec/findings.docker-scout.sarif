                "cvssV3_severity": "HIGH",
                "fixed_version": "1.24.9",
                "purls": [
                  "pkg:golang/stdlib@1.24.4"
                ],
                "security-severity": "7.5",
                "tags": [
                  "HIGH"
                ]
              }
            },
