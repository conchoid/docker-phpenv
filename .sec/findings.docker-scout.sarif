            {
              "id": "CVE-2026-32281",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-32281"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-32281?s=golang&n=stdlib&t=golang&vr=%3C1.25.9",
              "help": {
                "text": "Validating certificate chains which use policies is unexpectedly inefficient when certificates in the chain contain a very large number of policy mappings, possibly causing denial of service.\n\nThis only affects validation of otherwise trusted certificate chains, issued by a root CA in the VerifyOptions.Roots CertPool, or in the system certificate pool.\n",
                "markdown": "> Validating certificate chains which use policies is unexpectedly inefficient when certificates in the chain contain a very large number of policy mappings, possibly causing denial of service.\n\nThis only affects validation of otherwise trusted certificate chains, issued by a root CA in the VerifyOptions.Roots CertPool, or in the system certificate pool.\n\n|                                          |\n|Package         pkg:golang/stdlib@1.24.4  |\n|Affected range  <1.25.9                   |\n|Fixed version   1.25.9                    |\n"
              },
              "properties": {
                "affected_version": "<1.25.9",
